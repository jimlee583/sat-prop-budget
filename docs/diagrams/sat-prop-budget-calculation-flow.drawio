        <mxCell id="s1" value="&#xa;STAGE 1&#xa;Input" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#6c8ebf;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="105" y="107" width="80" height="50" as="geometry"/>
