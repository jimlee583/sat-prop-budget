        <mxCell id="s2" value="&#xa;STAGE 2&#xa;Validation" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#d6b656;rotation=-90;" vertex="1" parent="1">
