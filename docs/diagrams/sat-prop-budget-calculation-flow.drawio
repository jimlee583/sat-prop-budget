        </mxCell>
        <mxCell id="s3" value="&#xa;STAGE 3&#xa;Setup" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#82b366;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="105" y="510" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&#xa;STAGE 4&#xa;Bisection&#xa;Solver" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#82b366;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="90" y="720" width="80" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&#xa;STAGE 5&#xa;Maneuver&#xa;Loop" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#82b366;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="65" y="1080" width="80" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&#xa;STAGE 6&#xa;Convergence" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#d6b656;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="105" y="1595" width="80" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="&#xa;STAGE 7&#xa;Totals &amp;&#xa;Margins" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#82b366;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="105" y="1890" width="80" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="&#xa;STAGE 8&#xa;Results" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=10;fontColor=#9673a6;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="105" y="2270" width="80" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== N1: CALCULATION REQUEST INPUT ==================== -->
        <mxCell id="n1" value="&lt;b&gt;Calculation Request Input&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x2022; Maneuver list (ManeuverSpec[])&lt;br&gt;&#x2022; Satellite dry mass (kg)&lt;br&gt;&#x2022; Thruster Isp (s) per maneuver&lt;br&gt;&#x2022; &#x394;V per maneuver (m/s)&lt;br&gt;&#x2022; Occurrences per maneuver&lt;br&gt;&#x2022; Thruster efficiency factor&lt;br&gt;&#x2022; Propellant type (mono/biprop/xenon)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=20;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="60" width="380" height="170" as="geometry"/>
        </mxCell>

        <!-- ==================== N2: INPUT VALIDATION ==================== -->
        <mxCell id="n2" value="&lt;b&gt;Validate Inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;dry_mass &amp;gt; 0 ?&lt;br&gt;maneuvers &#x2260; empty ?&lt;br&gt;Isp &amp;gt; 0 ?&lt;br&gt;&#x394;V &#x2265; 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="275" y="280" width="250" height="140" as="geometry"/>
        </mxCell>

        <!-- N3: ERROR -->
        <mxCell id="n3" value="&lt;b&gt;Raise ValueError&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="330" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- ==================== N4: CALCULATE TOTAL DELTA-V ==================== -->
        <mxCell id="n4" value="&lt;b&gt;Calculate Total &#x394;V&lt;/b&gt;&lt;br&gt;total_&#x394;V = &#x2211;(&#x394;V &#xd7; occurrences)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="470" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== N5: DELTA-V = 0 ? ==================== -->
        <mxCell id="n5" value="&lt;b&gt;Total &#x394;V = 0 ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- N6: RETURN ZERO -->
        <mxCell id="n6" value="&lt;b&gt;Return Zero&lt;/b&gt;&lt;br&gt;Propellant Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="570" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== N7: INITIALIZE BISECTION SOLVER ==================== -->
        <mxCell id="n7" value="&lt;b&gt;Initialize Bisection Solver&lt;/b&gt;&lt;br&gt;m_low = dry_mass + &#x03B5;&lt;br&gt;m_high = dry_mass + 20,000 kg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="680" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== N8: COMPUTE MIDPOINT ==================== -->
        <mxCell id="n8" value="&lt;b&gt;Compute Midpoint&lt;/b&gt;&lt;br&gt;m_mid = (m_low + m_high) / 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="790" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== N9: BEGIN MANEUVER SEQUENCE ==================== -->
        <mxCell id="n9" value="&lt;b&gt;Begin Maneuver Sequence&lt;/b&gt;&lt;br&gt;m_current = m_mid&lt;br&gt;total_propellant = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="890" width="260" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== N10: GET MANEUVER PARAMETERS ==================== -->
        <mxCell id="n10" value="&lt;b&gt;Get Maneuver Parameters&lt;/b&gt;&lt;br&gt;Isp_eff = Isp &#xd7; efficiency&lt;br&gt;&#x394;V_total = &#x394;V &#xd7; occurrences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="995" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== N11: ROCKET EQUATION ==================== -->
        <mxCell id="n11" value="&lt;b&gt;Tsiolkovsky Rocket Equation&lt;/b&gt;&lt;br&gt;&lt;br&gt;g&#x2080; = 9.80665 m/s&#xb2;&lt;br&gt;MR = exp(&#x394;V / (g&#x2080; &#xd7; Isp))&lt;br&gt;m_after = m_before / MR&lt;br&gt;propellant = m_before &#x2212; m_after" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="255" y="1105" width="290" height="110" as="geometry"/>
        </mxCell>

        <!-- ==================== N12: PROPELLANT TYPE DECISION ==================== -->
        <mxCell id="n12" value="&lt;b&gt;Propellant&lt;br&gt;Type?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="1265" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- N13: BIPROP SPLIT -->
        <mxCell id="n13" value="&lt;b&gt;Biprop Split&lt;/b&gt;&lt;br&gt;fuel = prop / (1 + MR)&lt;br&gt;ox = prop &#x2212; fuel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="1395" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- N14: XENON -->
        <mxCell id="n14" value="&lt;b&gt;Xenon&lt;/b&gt;&lt;br&gt;xenon_kg = prop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="1395" width="180" height="45" as="geometry"/>
        </mxCell>

        <!-- N15: MONOPROP -->
        <mxCell id="n15" value="&lt;b&gt;Monoprop&lt;/b&gt;&lt;br&gt;hydrazine_kg = prop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="1395" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== N16: UPDATE MASS STATE ==================== -->
        <mxCell id="n16" value="&lt;b&gt;Update Mass State&lt;/b&gt;&lt;br&gt;m_current = m_after&lt;br&gt;total_propellant += prop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="1500" width="260" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== N17: MORE MANEUVERS? ==================== -->
        <mxCell id="n17" value="&lt;b&gt;More&lt;br&gt;Maneuvers?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="1605" width="150" height="80" as="geometry"/>
        </mxCell>

        <!-- ==================== N18: COMPUTE RESIDUAL ==================== -->
        <mxCell id="n18" value="&lt;b&gt;Compute Residual&lt;/b&gt;&lt;br&gt;available = m_mid &#x2212; dry_mass&lt;br&gt;residual = available &#x2212; total_propellant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="1740" width="280" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== N19: CONVERGED? ==================== -->
        <mxCell id="n19" value="&lt;b&gt;Converged?&lt;/b&gt;&lt;br&gt;|residual| &amp;lt; &#x03B5;&lt;br&gt;(&#x03B5; = 10&#x207b;&#x2076; kg)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="1845" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- N20: ADJUST BOUNDS -->
        <mxCell id="n20" value="&lt;b&gt;Adjust Bisection Bounds&lt;/b&gt;&lt;br&gt;res &amp;gt; 0 &#x2192; m_high = m_mid&lt;br&gt;res &amp;lt; 0 &#x2192; m_low = m_mid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="1875" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== N21: FINAL COMPUTATION ==================== -->
        <mxCell id="n21" value="&lt;b&gt;Final Computation&lt;/b&gt;&lt;br&gt;Recompute propellant breakdown&lt;br&gt;with converged initial mass m&#x2080;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="2010" width="260" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== N22: ACCUMULATE TOTALS ==================== -->
        <mxCell id="n22" value="&lt;b&gt;Accumulate Totals&lt;/b&gt;&lt;br&gt;&#x2022; Sum hydrazine, oxidizer, xenon&lt;br&gt;&#x2022; Per-maneuver breakdown&lt;br&gt;&#x2022; Total propellant mass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="2115" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- ==================== N23: FEASIBILITY CHECK ==================== -->
        <mxCell id="n23" value="&lt;b&gt;Feasibility&lt;br&gt;Check&lt;/b&gt;&lt;br&gt;&lt;br&gt;mass_margin =&lt;br&gt;launch_cap &#x2212; m&#x2080;&lt;br&gt;feasible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="2235" width="200" height="130" as="geometry"/>
        </mxCell>

        <!-- ==================== N24: TANK CONSTRAINT CHECK ==================== -->
        <mxCell id="n24" value="&lt;b&gt;Check Tank Constraints&lt;/b&gt;&lt;br&gt;hydrazine vs. tank capacity&lt;br&gt;oxidizer vs. tank capacity&lt;br&gt;xenon vs. tank capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="2415" width="270" height="65" as="geometry"/>
        </mxCell>

        <!-- ==================== N25: GENERATE RESULTS ==================== -->
        <mxCell id="n25" value="&lt;b&gt;Generate Results Object&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x2022; initial_mass_kg, dry_mass_kg&lt;br&gt;&#x2022; total_propellant_kg&lt;br&gt;&#x2022; Per-maneuver breakdown&lt;br&gt;&#x2022; Feasibility &amp;amp; mass margin&lt;br&gt;&#x2022; Tank constraint violations&lt;br&gt;&#x2022; Convergence status" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=30;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="205" y="2530" width="390" height="155" as="geometry"/>
        </mxCell>

        <!-- ==================== N26: RETURN RESULTS ==================== -->
        <mxCell id="n26" value="&lt;b&gt;Return Results&lt;br&gt;to API Layer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="315" y="2735" width="170" height="50" as="geometry"/>
        </mxCell>

